# Zava Contact Center — Agent Workspace
# All variables are optional. Copy this file to .env.local to override defaults
# during local development. In Azure, prefer public/region-config.json and
# public/entra-config.json so settings can change without rebuilding.

# Installed lab builds use real Microsoft Entra sign-in.
VITE_AUTH_MODE=entra

# Entra ID app registration for Microsoft sign-in. Register an SPA redirect URI
# at the site root, not /login. The app starts redirects from /login internally.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=common
VITE_AZURE_REDIRECT_URI=http://localhost:5173/

# Handoff service base URL. The current install points this at the Azure
# Functions handoff service /api. MCS uses /cua-run and Foundry uses
# /foundry-claims on the same base.
VITE_ORCHESTRATOR_URL=http://localhost:7071/api

# Optional second destination if you deliberately split MCS and Foundry bases.
# Most installs leave this unset and use region-config.json instead.
# VITE_FOUNDRY_ORCHESTRATOR_URL=https://<function-app>.azurewebsites.net/api
# VITE_DEFAULT_BACKEND=mcs

# Brand override (rarely needed)
VITE_BUILD_VERSION=3.2.0

# Optional Copilot Studio Direct Line token endpoint for in-app stream
# compatibility. This is not the supported MCS trigger path; the supported path
# is Dataverse-triggered Computer Use through /api/cua-run.
# VITE_DIRECTLINE_TOKEN_URL=https://<env>.environment.api.powerplatform.com/powervirtualagents/botsbyschema/<schema>/directline/token?api-version=2022-03-01-preview
