# Documentation only: Python does not automatically load this file.
# Supply via your process environment or the parameterized deployment script.
# Inbound API and scope are YOUR customer-owned Entra configuration, not a
# Microsoft/Agent 365 permission. For Entra v2, audience is the bare API GUID.
NH_PUBLIC_ORIGIN=https://<your-app>-<your-slot>.azurewebsites.net
NH_TENANT_ID=<tenant-guid>
NH_API_AUDIENCE=<customer-api-guid>
NH_MCP_CLIENT_ID=<approved-oauth-client-guid>
NH_USE_SCOPE=<customer-delegated-scope-name>

# Direct Functions uses standard Authorization. Leave false unless explicitly
# deploying behind SWA with its independently configured header-copy policy.
NH_PRESERVE_SWA_HEADER=false
ZAVA_DELAY_PROBE_ENABLED=false
# Informational fail-closed flags: this auth-only composition cannot enable them.
ZAVA_GATEWAY_ENABLED=false
ZAVA_REQUEST_REGISTRATION_ENABLED=false
