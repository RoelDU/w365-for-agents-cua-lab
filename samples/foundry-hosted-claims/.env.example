# Documentation only: the application does not auto-load dotenv files.
# Do not enable either gate without explicit approval.
LIVE_EXECUTION_APPROVED=no
CLAIMS_EXECUTION_APPROVED=no
# Optional, separately approved identity-only hosted version; keep empty normally.
# This replaces the live host, permits only this request/session, and never calls tools.
CLAIMS_IDENTITY_PROBE_REQUEST_ID=
# Optional metadata-only hosted version. Never configure both probe settings.
# It discovers W365 tools but cannot acquire a PC, invoke a tool, or call a model.
CLAIMS_TOOLING_PROBE_REQUEST_ID=
PYTHON_ENVIRONMENT=Production

# Native hosting reads FOUNDRY_AGENT_TENANT_ID, FOUNDRY_AGENT_BLUEPRINT_CLIENT_ID
# and FOUNDRY_AGENT_INSTANCE_CLIENT_ID. Do not override platform variables.
# These custom values are verified fallbacks; conflicting overrides are rejected.
CLAIMS_TENANT_ID=
CLAIMS_BLUEPRINT_ID=
CLAIMS_AGENT_ID=
# Explicitly verified agent-user OBJECT ID, not the human handoff requester.
CLAIMS_AGENT_USER_ID=
# identity_proxy_manager OR workload_identity. Neither is auto-detected.
CLAIMS_AUTH_TYPE=
# Optional assertion: must match the blueprint CLIENT ID (the native SDK mapping).
# identity_proxy_manager uses the resolved blueprint client ID when this is empty.
CLAIMS_PROXY_CLIENT_ID=
# workload_identity only: externally supplied and rotated assertion, never an image secret.
CLAIMS_FEDERATED_TOKEN_FILE=

# Versioned bundle used by Microsoft's W365A Playground; no invented environment URL.
SCREEN_SHARE_SDK_URL=https://packages.global.cloudinferenceplatform.azure.com/screenshare-sdk/1.0.0/screenshare-embed.js
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# Foundry injects FOUNDRY_PROJECT_ENDPOINT and HOME. Do not override them.
# For a wheel outside the repository, CLAIMS_SCHEMA_DIR must locate the shared schemas.

# Viewer only; exact deployed invocation endpoint, no alternate Cloud PC.
HOSTED_AGENT_ENDPOINT=
VIEWER_PORT=8099
